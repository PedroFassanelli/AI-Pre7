# Copiá este archivo a .env y completá los valores.
#   Windows:      Copy-Item .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# El .env está en .gitignore: nunca se sube al repositorio.

# --- Proveedor del LLM ------------------------------------------------------
# openai | anthropic
PROVEEDOR=openai

# Clave del proveedor elegido. Solo hace falta la del que uses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo de especialistas, sintetizador y planificador. Vacío = default:
#   openai -> gpt-4o-mini   |   anthropic -> claude-haiku-4-5
MODELO=
# Modelo del supervisor (el único rol que decide el flujo). Vacío = MODELO.
MODELO_SUPERVISOR=gpt-4o
TEMPERATURA=0

# --- Condiciones de parada del orquestador (Pre-entrega 6) ------------------
MAX_PASOS_SUPERVISOR=6
MAX_RONDAS_POR_AGENTE=2
LIMITE_RECURSION_ESPECIALISTA=12

# --- Redis: estado de los jobs, cola de Arq y checkpoints de LangGraph -------
# Con docker compose, la API y el worker usan redis://redis:6379/0 (lo pisa el
# compose). Este valor es para correrlos fuera de Docker.
REDIS_URL=redis://localhost:6379/0
# Vida de un job (y de sus checkpoints) desde su última actualización.
TTL_JOB_SEGUNDOS=86400

# --- Worker -------------------------------------------------------------------
# Tiempo máximo de una corrida del grafo. Pasado eso: FAILED.
TIMEOUT_TAREA_SEGUNDOS=300
# Corrutinas simultáneas por proceso worker.
MAX_TAREAS_CONCURRENTES=10

# --- Human-in-the-loop ----------------------------------------------------------
# Toda acción con efectos pide aprobación. Estos umbrales agregan razones
# ("monto alto", "acción masiva") a lo que ve quien aprueba.
UMBRAL_MONTO_ALTO_CENTAVOS=1000000
UMBRAL_PAGOS_MASIVO=3

# --- Observabilidad (Arize Phoenix) -------------------------------------------
TRAZAS_ACTIVAS=1
# Con docker compose lo pisa el compose (http://phoenix:6006/v1/traces).
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=nimbus-api
